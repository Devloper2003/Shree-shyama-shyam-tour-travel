// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Booking enquiries submitted through the website's contact/booking form.
// Each row is one customer enquiry — saved here so the business has a record
// even if the email/WhatsApp notification is missed.
model Enquiry {
  id          String   @id @default(cuid())
  // Customer info
  name        String
  phone       String
  email       String?
  // Trip details
  pickup      String
  drop        String
  yatraPackage String?
  vehicleType String?
  tripType    String? // one-way, round-trip, local, airport, tour-package
  pickupDate  String?
  pickupTime  String?
  passengers  String?
  notes       String?
  // Source so we can later differentiate home form vs route card vs fare calc
  source      String   @default("contact-form")
  // Status workflow: new -> contacted -> confirmed -> closed
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Blog posts managed by the owner/admin via the admin panel
model BlogPost {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  content   String?
  category  String   @default("General")
  image     String?  // path to uploaded image (e.g. /blog/blog-xxx.jpg)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
}

// Special offers managed by the owner/admin
model Offer {
  id          String   @id @default(cuid())
  title       String
  description String
  discount    String?
  validTill   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// Key-value settings store (admin password, etc.)
model Setting {
  key   String @id
  value String
}

# ============================================================================
#  ENVIRONMENT VARIABLES — copy this file to ".env" and fill in real values
#  NEVER commit the real .env file — it is gitignored.
# ============================================================================

# PostgreSQL database connection string (Neon, Supabase, or any hosted Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend API key for email notifications (https://resend.com/api-keys)
RESEND_API_KEY=""

# Email address where new enquiry notifications are sent (admin's email)
ENQUIRY_NOTIFY_EMAIL="your-email@gmail.com"

# From address for outgoing emails (must be verified in Resend)
# For testing only: onboarding@resend.dev (sends only to your Resend account email)
RESEND_FROM_EMAIL="Sri Shyama Travels <noreply@yourdomain.com>"

# Initial admin password — used ONLY by scripts/init-admin-password.ts
# to set the bcrypt-hashed password in the database.
# Leave blank to be prompted interactively when running the script.
# NEVER set this in production Vercel env vars unless doing first-time setup.
ADMIN_INITIAL_PASSWORD=""

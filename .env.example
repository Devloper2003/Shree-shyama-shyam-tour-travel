# Database URL — SQLite local file (used by Prisma)
DATABASE_URL="file:./db/custom.db"

# Admin default password — used only if no custom password is set in the database.
# Change this to a strong password. The admin can also change it via the Settings tab.
ADMIN_DEFAULT_PASSWORD="vithika2026"

# Resend API key for email notifications — when a new enquiry is submitted,
# an email is sent to the business owner via Resend.
# Get your API key from https://resend.com/api-keys
# Leave empty to skip email sending (enquiries still save to database + WhatsApp links work)
RESEND_API_KEY=""

# Email address that receives enquiry notifications
# This should be the business owner's email
ENQUIRY_NOTIFY_EMAIL="bookings@shrishyamashyamtravels.in"

# From email for Resend — must be a verified domain in your Resend account
# Use "onboarding@resend.dev" for testing (only sends to your Resend account email)
# For production, verify your domain at https://resend.com/domains
RESEND_FROM_EMAIL="Shri Shyama Shyam Travels <onboarding@resend.dev>"
